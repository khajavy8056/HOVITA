# ============================================================
# HOVITA (.env.example) — Server-side secrets & policies only
# Never expose secrets to browser/frontend code!
# ============================================================

# --- Single-Persona Installation Identity ---
HOVITA_ENV=development
CHARACTER_ID=persona-001
CHARACTER_NAME=Hovita Persona
APP_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO

# --- Brain & Database ---
# Production VPS: postgresql+psycopg://hovita:hovita@postgres:5432/hovita
# Thin / Notebook / Local fallback: sqlite:///./data/hovita.db
DATABASE_URL=sqlite:///./data/hovita.db
REDIS_URL=memory://
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hovita-assets
MINIO_SECURE=false

# Conditional n8n bridge (ONLY when customer self-hosts or holds commercial license)
N8N_ENABLED=false
N8N_HOST=
N8N_API_KEY=

# Model Gateway (Free-first chain: S0 Ollama -> S1 FreeLLMAPI/Groq/Gemini -> S2 OpenRouter -> S3 Claude/Gemini)
BRAIN_MODEL_GATE=free_first
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_LIGHT=qwen3:8b
OLLAMA_MODEL_MEDIUM=qwen3:14b
FREELLMAPI_BASE_URL=
FREELLMAPI_KEY=

# --- Models & Media Engines (Local tools need no keys) ---
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=qwen/qwen3-14b:free
OPENROUTER_ECO_MODEL=deepseek/deepseek-chat
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FAL_KEY=
HF_TOKEN=
COMFYUI_BASE_URL=http://localhost:8188
POCKET_TTS_FARSI_URL=http://localhost:8010
FASTER_WHISPER_MODEL=small

# --- Social Networks (Official APIs only) ---
META_APP_ID=
META_APP_SECRET=
# 60-day long-lived user/page token (server secret store only)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_TOKEN=

# --- Trends & Research ---
SEARXNG_BASE_URL=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
ENSEMBLEDATA_API_KEY=
APIFY_TOKEN=

# --- Memory & Observability ---
MEM0_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Live Voice / Video Call ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
HEYGEN_API_KEY=
TAVUS_API_KEY=
D_ID_API_KEY=

# --- Policies, Quality Gates & Economy ---
QA_FACE_THRESHOLD=0.72
QA_HOOK_MIN_SCORE=6.0
QA_LIP_SYNC_MIN_PCT=95.0
QA_MIN_DURATION_SEC=15
QA_MAX_DURATION_SEC=45
QA_MAX_REVISIONS=2
DAILY_BUDGET_USD=3.0
BUDGET_WARN_PCT=0.80
AUTONOMY_LEVEL=L1
PUBLISH_MODE=approval_required

# --- Quotas & GPU Resource Management ---
IG_DAILY_PUBLISH_LIMIT=50
IG_HOURLY_API_LIMIT=200
TIKTOK_DAILY_PUBLISH_LIMIT=25
GPU_MODE=on_demand
GPU_AVAILABLE=false
GPU_IDLE_SLEEP_MINUTES=10
GPU_POWER_WATTS=250
GPU_ELECTRICITY_USD_PER_KWH=0.12
GPU_RENTAL_USD_PER_HOUR=0.45

# --- Browser Read-Only Layer ---
BROWSER_LAYER_ENABLED=true
BROWSER_DAILY_READ_LIMIT=100
BROWSER_ALLOW_FALLBACK_PUBLISH=false

# --- Secret Store Encryption ---
SECRET_MASTER_KEY=
SECRET_STORE_PATH=./data/secrets.enc.json
